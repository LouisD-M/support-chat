                    "build":  "npm run build -ws --if-present",
                    "build:api":  "npm run build -w apps/api",
                    "build:client":  "npm run build -w apps/client",
                    "build:admin":  "npm run build -w apps/admin",
                    "dev":  "concurrently -n API,CLIENT,ADMIN \"npm run dev:api\" \"npm run dev:client\" \"npm run dev:admin\""
                },
